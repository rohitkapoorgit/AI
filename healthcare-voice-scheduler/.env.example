# Copy to .env and fill in real values. Never commit .env.

# Phase 1 (done) — required now.
ANTHROPIC_API_KEY=

# Phase 2 (docs/PHASE2_VOICE.md) — real voice channel.
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Phase 3 (docs/PHASE3_EVAL.md) — only if evaluation picks Cartesia as a TTS candidate.
CARTESIA_API_KEY=

# Phase 2.3 (docs/PHASE2_3_SCHEDULING_BACKEND.md) — real scheduling backend.
# "mock" (default, no external calls) or "sandbox" (real NPPES + FHIR sandbox calls) --
# applies uniformly to scripts/run_console_call.py, voice_bot_claude_agent.py, and
# voice_bot_native_llm.py.
SCHEDULING_BACKEND=mock
FHIR_SANDBOX_BASE_URL=https://launch.smarthealthit.org/v/r4/fhir
NPPES_API_BASE_URL=https://npiregistry.cms.hhs.gov/api
