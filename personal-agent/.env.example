ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# NWS asks API consumers to identify themselves in the User-Agent header
# (contact info for abuse/rate-limit follow-up) — put your own email here.
WEATHER_API_CONTACT=your-email@example.com

# Free registration at https://api.bart.gov/api/register.aspx — omit to fall back to
# BART's shared public test key (fine for development, but get your own for real use).
BART_API_KEY=

# Gmail OAuth (read-only) — see src/personal_agent/mcp_servers/gmail_server.py docstring
# for the one-time Google Cloud Console setup. Defaults below are usually fine as-is.
GMAIL_OAUTH_CREDENTIALS_PATH=.secrets/gmail_credentials.json
GMAIL_OAUTH_TOKEN_PATH=.secrets/gmail_token.json

# Gmail send (delivery) — separate, narrower-scoped token from the read-only one above.
# See src/personal_agent/delivery.py docstring for setup (add gmail.send to the same
# OAuth consent screen). DIGEST_RECIPIENT is who the morning digest gets sent to.
GMAIL_SEND_TOKEN_PATH=.secrets/gmail_send_token.json
DIGEST_RECIPIENT=
DIGEST_SUBJECT_PREFIX=Morning Digest
